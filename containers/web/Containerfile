# Web image: the static app served by an unprivileged nginx. Build context = repository root:
#   podman build -t localhost/gtm-web:dev -f containers/web/Containerfile .
# Fully-qualified image name on purpose (podman has no default registry guarantee).
FROM docker.io/nginxinc/nginx-unprivileged:alpine

# A template, not a ready config: the entrypoint renders it into /etc/nginx/conf.d at start (a tmpfs, so the root
# filesystem can stay read-only) with the container's DNS resolver filled in, see the /api/ location.
COPY containers/web/nginx.conf /etc/nginx/templates/default.conf.template
COPY web/index.html web/style.css web/pieces.svg web/theme.js web/strings.js web/scoring.js web/board.js web/app.js /usr/share/nginx/html/
# Demo dataset baked in so the image works on its own; compose/Quadlet bind-mount a real one over it.
COPY web/data/ /usr/share/nginx/html/data/

EXPOSE 8080
# No HEALTHCHECK here: podman builds OCI images by default and OCI has no such field (it is ignored with a
# warning). The health check is passed at run time instead: Makefile --health-cmd, compose `healthcheck:`,
# Quadlet HealthCmd=. All three probe /healthz with busybox wget.
