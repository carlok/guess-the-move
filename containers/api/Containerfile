# api image: Stockfish + (optionally) Maia-2 behind a small ASGI app. Build context = repository root:
#   podman build -t localhost/gtm-api:dev -f containers/api/Containerfile .
#   podman build --build-arg WITH_MAIA=1 --build-arg MAIA_MODE=maia3 -t localhost/gtm-api:maia -f containers/api/Containerfile .
# (`make api-image` / `make api-image WITH_MAIA=1` pass both arguments.) Runs as an unprivileged user; use --read-only
# --tmpfs /tmp --cap-drop=all. Maia's 280 MB weights are NOT baked in: they live in the /models volume
# (`make api-weights` downloads them once).
FROM docker.io/library/python:3.12-slim

ARG WITH_MAIA=0
ARG MAIA_MODE=none
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    GTM_API_ENGINE=/usr/games/stockfish MAIA2_HOME=/models HOME=/tmp GTM_API_MAIA=${MAIA_MODE}

RUN apt-get update \
 && apt-get install -y --no-install-recommends stockfish \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin gtm \
 && mkdir /models && chown gtm:gtm /models

WORKDIR /app
COPY requirements.txt requirements-api.txt requirements-maia.txt requirements-maia3.txt ./
RUN pip install -r requirements.txt -r requirements-api.txt \
 && if [ "$WITH_MAIA" = "1" ]; then \
      pip install --index-url https://download.pytorch.org/whl/cpu torch \
      && if [ "$MAIA_MODE" = "maia3" ]; then pip install -r requirements-maia3.txt; else pip install -r requirements-maia.txt; fi; \
    fi

COPY pipeline/ pipeline/
COPY api/ api/

USER 10001
EXPOSE 8000
VOLUME /models
# No HEALTHCHECK instruction (podman builds OCI images, which ignore it): health is passed at run time.
CMD ["uvicorn", "--factory", "api.main:build_app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--workers", "1"]
