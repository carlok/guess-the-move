{
  "name": "guess-the-move-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static front-end for Guess-the-Move. No runtime dependencies; jsdom is used only by the tests.",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=scoring.js --test-coverage-include=app.js --test-coverage-lines=95 --test-coverage-branches=90 \"test/*.test.js\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3"
  }
}
