{
  "name": "guess-the-move-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static front-end for Guess-the-Move. No runtime dependencies; jsdom is used only by the tests.",
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.slow.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=scoring.js --test-coverage-include=board.js --test-coverage-include=theme.js --test-coverage-include=app.js --test-coverage-include=sound.js --test-coverage-include=stats.js --test-coverage-include=statscharts.js --test-coverage-include=backup.js --test-coverage-include=level.js --test-coverage-include=classify.js --test-coverage-include=srs.js --test-coverage-include=report.js --test-coverage-include=pwa.js --test-coverage-include=share.js --test-coverage-include=seed.js --test-coverage-include=tierview.js --test-coverage-lines=95 --test-coverage-branches=90 \"test/*.test.js\"",
    "e2e": "playwright test",
    "test:fast": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3"
  }
}
